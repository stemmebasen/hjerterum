{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hjerterum-platform",
  "compatibility_date": "2026-09-07",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./worker/config-entry.ts",
  "keep_vars": true,
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "vars": {
    "ENVIRONMENT": "local"
  },
  "env": {
    "staging": {
      "name": "hjerterum-platform-staging",
      "vars": {
        "ENVIRONMENT": "staging",
        "SAGA_TELEGRAM_BOT_USERNAME": "jacobhaugemathiassen_bot_bot",
        "SAGA_BOARD_CHAT_ID": "-1003488840083",
        "SAGA_OWNER_TELEGRAM_ID": "8490500029",
        "AI_BASE_URL": "https://router.eu.requesty.ai/v1",
        "AI_MODEL": "vertex/claude-sonnet-5-5@eu",
        "GOOGLE_MINUTES_DOC_ID": "1fqEys6iYSXu5XG81EyT45YVfbhRjVlq86ERVbHn1Mzs",
        "COCKPIT_URL": "https://admin.hjerterum.info",
        "RESEND_FROM_EMAIL": "Hjerterum <login@hjerterum.info>",
        "SAGA_MINUTES_PING": "off"
      },
      "triggers": {
        "crons": ["*/5 * * * *"]
      },
      "r2_buckets": [
        {
          "binding": "BOARD_RECORDINGS",
          "bucket_name": "hjerterum-board-recordings-eu"
        }
      ]
    },
    "production": {
      "name": "hjerterum-platform-production",
      "vars": {
        "ENVIRONMENT": "production",
        "AI_BASE_URL": "https://router.eu.requesty.ai/v1",
        "AI_MODEL": "vertex/claude-sonnet-5-5@eu"
      },
      "triggers": {
        "crons": ["*/5 * * * *"]
      }
    }
  }
}
